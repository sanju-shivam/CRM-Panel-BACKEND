# Copy to .env (git-ignored) and fill in:
#   cp .env.example .env
# On Render these are set in the service's Environment tab instead.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Browser origin(s) allowed to call the API, comma-separated. On Render: the
# frontend static site URL, e.g. https://crm-web.onrender.com
CORS_ORIGIN=http://localhost:4200

# No authentication layer: every request runs against this account.
DEFAULT_ACCOUNT_ID=00000000-0000-4000-8000-0000000000aa

# --- Database ----------------------------------------------------------------
# DATABASE_URL - runtime queries.
# DIRECT_URL   - Prisma CLI / migrations (never the transaction pooler).
#
# Local PostgreSQL (docker compose up -d):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm_dev"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/crm_dev"
#
# Supabase, direct host (needs IPv6 on your network):
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
# DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
#
# Supabase on Render (IPv4 only -> Supavisor pooler, from Supabase -> Connect).
# URL-encode special characters in the password (@ -> %40, # -> %23, $ -> %24).
# DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres"

# Tests ignore the values above: .env.test pins them to the local crm_test
# database, and the suite refuses to run against Supabase.

# --- Seed --------------------------------------------------------------------
#   npm run db:seed                      # local database
#   SEED_CONFIRM=yes npm run db:seed     # Supabase (wipes the demo account's data)
