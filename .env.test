# Automated test environment.
#
# Loaded with override by vitest.config.mts and tests/global-setup.ts, so the backend test suite ALWAYS runs against
# the local PostgreSQL test database - even when .env is configured for the
# Supabase demo database. Tests mutate/truncate data and must stay
# deterministic and fast, so they never run against Supabase.
NODE_ENV=test
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm_test"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/crm_test"
LOG_LEVEL=silent
